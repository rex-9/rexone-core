# ====================================================================
# RAILS ENVIRONMENT
# ====================================================================
RAILS_ENV=development
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=7
RAILS_SERVER_HOST=localhost
RAILS_CLIENT_BASE_URL=http://localhost:4000
RAILS_SERVER_BASE_URL=http://localhost:3000

# ====================================================================
# DATABASE (PostgreSQL)
# ====================================================================
RAILS_DATABASE_URL=postgres://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${PG_DATABASE}

# OR individual variables (if not using DATABASE_URL)
# PG_HOST=db
# PG_PORT=5432
# PG_DATABASE=rexone_core_development
# PG_USER=postgres
# PG_PASSWORD=password
# PG_PORT_MAP=5432:5432

# ====================================================================
# SOLID QUEUE - Workers
# ====================================================================
SOLID_QUEUE_WORKERS=4
# SOLID_QUEUE_IN_PUMA=0

# ====================================================================
# JWT AUTHENTICATION
# ====================================================================
RAILS_JWT_SECRET_KEY=rexone
JWT_EXPIRATION=604800  # 7 days in seconds
SESSION_TIMEOUT=604800  # 7 days in seconds
PASSWORD_RESET_WITHIN=3600  # 1 hour in seconds
ALLOW_UNCONFIRMED_ACCESS_FOR=86400  # 1 day in seconds

# ====================================================================
# EMAIL / SMTP
# ====================================================================
FROM_EMAIL=support@rexone.me
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=rexone.me
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# ====================================================================
# STRIPE PAYMENTS
# ====================================================================

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:4000/success
STRIPE_CANCEL_URL=http://localhost:4000/cancel

# ====================================================================
# ONESIGNAL - Push Notifications
# ====================================================================
ONE_SIGNAL_APP_ID=
ONE_SIGNAL_API_KEY=
ONE_SIGNAL_DEFAULT_SOUND=default

# ====================================================================
# AI / DEEPSEEK
# ====================================================================
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ====================================================================
# CLOUDINARY - File Storage
# ====================================================================

STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ====================================================================
# Dev only environments if you use non-docker setup for deployment
# DOCKER CONFIGURATION
# ====================================================================
RAILS_DOCKERFILE=Dockerfile.dev
RAILS_PORT_MAP=3000:3000
RAILS_CONTAINER_NAME=dev-rexone-core-api
WAKA_CONTAINER_NAME=dev-rexone-core-waka
DB_CONTAINER_NAME=dev-rexone-core-db
PG_PORT_MAP=5432:5432
PG_PASSWORD=password



# Cloudinary:
#   CLOUDINARY_CLOUD_NAME: your-cloud-name
#   CLOUDINARY_API_KEY: your-api-key
#   CLOUDINARY_API_SECRET: your-api-secret
#
# Local:
#   LOCAL_STORAGE_PATH: /path/to/storage (default: Rails.root/storage)
