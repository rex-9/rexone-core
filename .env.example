# ====================================================================
# RAILS ENVIRONMENT
# ====================================================================
RAILS_ENV=development
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=7
PORT=3000
DB_POOL=7
API_DB_POOL=7
WAKA_DB_POOL=5
MEDIA_DB_POOL=3
RAILS_SERVER_HOST=localhost
RAILS_CLIENT_BASE_URL=http://localhost:4000
RAILS_SERVER_BASE_URL=http://localhost:3000
RAILS_SECRET_KEY_BASE=secret-key-base
RAILS_MASTER_KEY=master-key

# ====================================================================
# DATABASE (PostgreSQL)
# ====================================================================
RAILS_DATABASE_URL=postgres://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${PG_DATABASE}
# RAILS_TEST_DATABASE_URL=postgres://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/rexone_core_test

PG_HOST=db
PG_PORT=5432
PG_DATABASE=rexone_core_development
PG_USER=postgres
PG_PASSWORD=password

# ====================================================================
# SOLID QUEUE - Workers
# ====================================================================
# SOLID_QUEUE_IN_PUMA=0
SOLID_QUEUE_SHUTDOWN_TIMEOUT=30  # 30 seconds grace period during deploy/shutdown
# PIDFILE=tmp/pids/server.pid

# ====================================================================
# JWT AUTHENTICATION
# ====================================================================
RAILS_JWT_SECRET_KEY=rexone
JWT_EXPIRATION=604800  # 7 days in seconds
SESSION_TIMEOUT=604800  # 7 days in seconds
PASSWORD_RESET_WITHIN=3600  # 1 hour in seconds
ALLOW_UNCONFIRMED_ACCESS_FOR=86400  # 1 day in seconds
CONFIRM_CODE_WITHIN=600  # 10 minutes in seconds

# ====================================================================
# EMAIL / SMTP
# ====================================================================
FROM_EMAIL=support@rexone.me
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=rexone.me
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# ====================================================================
# STRIPE PAYMENTS
# ====================================================================

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:4000/success
STRIPE_CANCEL_URL=http://localhost:4000/cancel

# ====================================================================
# ONESIGNAL - Push Notifications
# ====================================================================
ONE_SIGNAL_APP_ID=
ONE_SIGNAL_API_KEY=
ONE_SIGNAL_DEFAULT_SOUND=default

# ====================================================================
# AI / DEEPSEEK
# ====================================================================
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ====================================================================
# Storage (Garage S3 Object Storage - Default)
# ====================================================================
STORAGE_PROVIDER=garage
S3_ENDPOINT=http://garage:3100
S3_PUBLIC_ENDPOINT=http://localhost:3100
S3_BUCKET=rexone
S3_REGION=garage
S3_ACCESS_KEY=garage_access_key
S3_SECRET_KEY=garage_secret_key
S3_ADMIN_ENDPOINT=http://garage:3101
S3_ADMIN_TOKEN=rexone_garage_admin_token_secret_key_12345
S3_PORT_MAP=3100:3100
S3_ADMIN_PORT_MAP=3101:3101

# ====================================================================
# CLOUDINARY - External File Storage (Optional fallback)
# ====================================================================
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret


# ====================================================================
# MEDIA COMPRESSION (Optional - requires media container)
# ====================================================================
MEDIA_CONTAINER_ENABLED=true

# Upload size limits in MB (default: 100 for video / 10 for non-video when MEDIA_CONTAINER_ENABLED=true; 10 / 1 when false)
MEDIA_MAX_VIDEO_SIZE_MB=100
MEDIA_MAX_NON_VIDEO_SIZE_MB=10

# Video compression profile
MEDIA_VIDEO_CRF=23
MEDIA_VIDEO_PRESET=medium
MEDIA_VIDEO_MAX_WIDTH=1920
MEDIA_VIDEO_MAX_HEIGHT=1080
MEDIA_VIDEO_MAX_BITRATE=5M
MEDIA_VIDEO_BUFFER_SIZE=10M
MEDIA_VIDEO_AUDIO_BITRATE=128k
MEDIA_VIDEO_CODEC=libx264
MEDIA_VIDEO_AUDIO_CODEC=aac

# Image compression profile
MEDIA_IMAGE_JPEG_QUALITY=82
MEDIA_IMAGE_PNG_QUALITY=82
MEDIA_IMAGE_PNG_COMPRESSION=9
MEDIA_IMAGE_WEBP_QUALITY=80
MEDIA_IMAGE_MAX_WIDTH=1920
MEDIA_IMAGE_MAX_HEIGHT=1080
MEDIA_MAX_COMPRESSION_PASSES=2

# ====================================================================
# Dev only environments if you use non-docker setup for deployment
# DOCKER CONFIGURATION
# ====================================================================
RAILS_DOCKERFILE=Dockerfile.dev
RAILS_PORT_MAP=3000:3000
RAILS_CONTAINER_NAME=dev-rexone-core-api
WAKA_CONTAINER_NAME=dev-rexone-core-waka
DB_CONTAINER_NAME=dev-rexone-core-db
MEDIA_CONTAINER_NAME=dev-rexone-core-media
GARAGE_CONTAINER_NAME=dev-rexone-core-garage
GARAGE_CONTAINER_ENABLED=true
PG_PORT_MAP=5432:5432
PG_PASSWORD=password

# ====================================================================
# Speech Service Api
# ====================================================================

SPEECH_SERVICE_BASE_URL=https://
SPEECH_TTS_ENDPOINT_PATH=/ssml-to-speech
SPEECH_STT_ENDPOINT_PATH=/speech-to-text

# Azure Speech (live STT). Leave the key blank to keep HTTP Nova STT/TTS only.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_VOICE=en-US-AvaNeural

# Local Filesystem Storage (Alternative fallback when STORAGE_PROVIDER=local):
# LOCAL_STORAGE_PATH=storage

# ====================================================================
# OBSERVABILITY & ERROR DASHBOARD (Rails Error Dashboard)
# ====================================================================
# DASHBOARD_BASE_URL=http://localhost:3000
# APP_VERSION=1.0.0
# GIT_SHA=main
