#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ] && [ -f /usr/lib/*/libjemalloc.so.2 ]; then
  export LD_PRELOAD="$(echo /usr/lib/*/libjemalloc.so.2)"
fi

# Remove old Puma PID file (if server is already running)
rm -f /rails/tmp/pids/server.pid

# Prepare the development database when starting the Rails API.
# Solid Queue (Waka) skips this step.
if [ "$RAILS_ENV" = "development" ] && [ "$1" != "./bin/jobs" ]; then
  echo "Preparing database..."
  bundle exec rake db:prepare
fi

# Identify Solid Queue Waka startup.
if [ "$1" = "./bin/jobs" ]; then
  echo "→ Starting Solid Queue waka..."
fi

# Continue with the command passed to the container.
exec "$@"