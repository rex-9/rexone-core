# ==============================================================================
# 👑 REXONE CORE — APPLICATION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Organized strictly by operational priority and architectural tiers:
#
#   🟢 TIER 1: CRITICAL LOCAL CORE (Required to boot Rails API, DB, and Garage S3)
#   🟡 TIER 2: BRANDING, DOMAINS & NETWORKING (URLs, CORS, and email identity)
#   🟠 TIER 3: PRIMARY SERVICES (OneSignal push/email & Stripe payments)
#   🟣 TIER 4: AI & MEDIA ENGINES (Gemini/DeepSeek LLMs, Audio/Video transcoding)
#   ⚪ TIER 5: OPTIONAL FALLBACKS & ADVANCED TUNING (Commented out by default)
# ==============================================================================


# ==============================================================================
# 🟢 TIER 1: CRITICAL LOCAL CORE (Required to boot Rails API, DB, & Garage S3)
# ==============================================================================

# 1. Rails Runtime Environment & Secrets
RAILS_ENV=development
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=7
PORT=3000
RAILS_TIMEZONE=UTC
RAILS_SECRET_KEY_BASE=changeme_rails_secret_key_base_min_32_characters_long
RAILS_MASTER_KEY=changeme_rails_master_key
RAILS_JWT_SECRET_KEY=changeme_jwt_secret_key

# 2. Database (PostgreSQL 18)
PG_HOST=db
PG_PORT=5432
PG_DATABASE=rexone_core
PG_USER=postgres
PG_PASSWORD=changeme_db_password
DB_POOL=7

RAILS_DATABASE_URL=postgres://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${PG_DATABASE}_development
RAILS_TEST_DATABASE_URL=postgres://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${PG_DATABASE}_test

# 3. Garage S3 Object Storage (Default Self-Hosted on port 3100)
STORAGE_PROVIDER=garage
S3_ENDPOINT=http://garage:3100
S3_PUBLIC_ENDPOINT=http://localhost:3100
S3_BUCKET=rexone
S3_REGION=garage
S3_FOLDER_PREFIX=dev
# S3_ACCESS_KEY and S3_SECRET_KEY will auto-generate on first run via ./scripts/dev_garage.sh if left blank.
S3_ACCESS_KEY=changeme_s3_access_key
S3_SECRET_KEY=changeme_s3_secret_key
S3_ADMIN_ENDPOINT=http://garage:3101
S3_ADMIN_TOKEN=changeme_garage_admin_token

# 4. Docker Container Names & Port Mappings
RAILS_DOCKERFILE=Dockerfile.dev
RAILS_CONTAINER_NAME=dev-rexone-core-api
WAKA_CONTAINER_NAME=dev-rexone-core-waka
DB_CONTAINER_NAME=dev-rexone-core-db
MEDIA_CONTAINER_NAME=dev-rexone-core-media
GARAGE_CONTAINER_NAME=dev-rexone-core-garage
GARAGE_CONTAINER_ENABLED=true

# Host:Container port bindings
RAILS_PORT_MAP=3000:3000
PG_PORT_MAP=5432:5432
S3_PORT_MAP=3100:3100
S3_ADMIN_PORT_MAP=127.0.0.1:3101:3101

# 5. Initial Super Admin Seeding
SEED_SUPER_ADMIN_EMAIL=superadmin@rexone.com
SEED_SUPER_ADMIN_PASSWORD=changeme_superadmin_password


# ==============================================================================
# 🟡 TIER 2: BRANDING, DOMAINS & NETWORKING
# ==============================================================================

PRODUCT_DOMAIN=rexone.com
RAILS_SERVER_HOST=localhost
RAILS_SERVER_BASE_URL=http://localhost:3000
RAILS_CLIENT_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:4000,https://rexone.com,https://uat.rexone.com
CORS_ALLOW_LOCALHOST=true
FROM_EMAIL=support@rexone.com


# ==============================================================================
# 🟠 TIER 3: PRIMARY SERVICES (OneSignal Push/Email & Stripe Payments)
# ==============================================================================

# 1. OneSignal — Handles Push Notifications AND Transactional Emails (No SMTP needed!)
EMAIL_PROVIDER=one_signal
ONE_SIGNAL_APP_ID=changeme_onesignal_app_id
ONE_SIGNAL_API_KEY=changeme_onesignal_rest_api_key
ONE_SIGNAL_DEFAULT_SOUND=default

# 2. Stripe Payments
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_PUBLISHABLE_KEY=pk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
STRIPE_SUCCESS_URL=http://localhost:4000/success
STRIPE_CANCEL_URL=http://localhost:4000/cancel
PAYMENT_BATCH_COUPON_LIMIT=100


# ==============================================================================
# 🟣 TIER 4: AI & MEDIA ENGINES (Gemini/DeepSeek LLMs, Audio/Video)
# ==============================================================================

# 1. AI Providers
GEMINI_API_KEY=AIzaSy_changeme
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=sk-changeme
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 2. Media Optimization & Audio Guidance Transcoding (FFmpeg + libvips)
MEDIA_CONTAINER_ENABLED=true
MEDIA_MAX_AUDIO_SIZE_MB=100
MEDIA_MAX_VIDEO_SIZE_MB=300
MEDIA_MAX_IMAGE_SIZE_MB=10
MEDIA_MAX_OTHER_SIZE_MB=30
MEDIA_AUDIO_BITRATE=128k
MEDIA_AUDIO_CODEC=aac
MEDIA_VIDEO_CRF=23
MEDIA_VIDEO_PRESET=medium
MEDIA_VIDEO_MAX_WIDTH=1920
MEDIA_VIDEO_MAX_HEIGHT=1080
MEDIA_VIDEO_MAX_BITRATE=5M
MEDIA_VIDEO_BUFFER_SIZE=10M
MEDIA_VIDEO_AUDIO_BITRATE=128k
MEDIA_VIDEO_CODEC=libx264
MEDIA_VIDEO_AUDIO_CODEC=aac
MEDIA_IMAGE_JPEG_QUALITY=82
MEDIA_IMAGE_PNG_QUALITY=82
MEDIA_IMAGE_PNG_COMPRESSION=9
MEDIA_IMAGE_WEBP_QUALITY=80
MEDIA_IMAGE_MAX_WIDTH=1920
MEDIA_IMAGE_MAX_HEIGHT=1080
MEDIA_MAX_COMPRESSION_PASSES=2
MEDIA_PLAYBACK_URL_TTL=3600


# ==============================================================================
# ⚪ TIER 5: OPTIONAL FALLBACKS & ADVANCED TUNING (Commented out by default)
# ==============================================================================

# ------------------------------------------------------------------------------
# 5.1 SMTP Fallback (NOT needed when EMAIL_PROVIDER=one_signal)
# ------------------------------------------------------------------------------
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_DOMAIN=rexone.com
# SMTP_USERNAME=changeme_smtp_username@example.com
# SMTP_PASSWORD=changeme_smtp_password

# ------------------------------------------------------------------------------
# 5.2 Brevo Email Provider (Alternative to OneSignal: set EMAIL_PROVIDER=brevo)
# ------------------------------------------------------------------------------
# BREVO_API_KEY=changeme_brevo_api_key
# BREVO_BASE_URL=https://api.brevo.com/v3

# ------------------------------------------------------------------------------
# 5.3 In-App Purchases (Google Play & Apple App Store Server Verification)
# ------------------------------------------------------------------------------
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# GOOGLE_PLAY_PACKAGE_NAME=com.rex9.rexone
# APPLE_APP_STORE_ISSUER_ID=
# APPLE_APP_STORE_KEY_ID=
# APPLE_APP_STORE_PRIVATE_KEY=
# APPLE_APP_STORE_BUNDLE_ID=com.rex9.rexone

# ------------------------------------------------------------------------------
# 5.4 Alternative Storage Providers (Cloudinary or Local Disk)
# ------------------------------------------------------------------------------
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_URL=cloudinary://changeme_api_key:changeme_api_secret@changeme_cloud_name
# CLOUDINARY_CLOUD_NAME=changeme_cloud_name
# CLOUDINARY_API_KEY=changeme_api_key
# CLOUDINARY_API_SECRET=changeme_api_secret
# LOCAL_STORAGE_PATH=storage

# ------------------------------------------------------------------------------
# 5.5 Azure Speech / Custom STT/TTS
# ------------------------------------------------------------------------------
# AZURE_SPEECH_KEY=changeme_azure_speech_key
# AZURE_SPEECH_REGION=southeastasia
# AZURE_SPEECH_LANGUAGE=en-US
# AZURE_SPEECH_VOICE=en-US-AvaNeural
# SPEECH_SERVICE_BASE_URL=https://speech.example.com
# SPEECH_TTS_ENDPOINT_PATH=/ssml-to-speech
# SPEECH_STT_ENDPOINT_PATH=/speech-to-text

# ------------------------------------------------------------------------------
# 5.6 Session Lifecycles & Security Timeouts (Sensible defaults in code)
# ------------------------------------------------------------------------------
# JWT_EXPIRATION=604800              # 7 days in seconds
# SESSION_TIMEOUT=604800             # 7 days in seconds
# PASSWORD_RESET_WITHIN=3600         # 1 hour in seconds
# ALLOW_UNCONFIRMED_ACCESS_FOR=86400 # 1 day in seconds
# CONFIRM_CODE_WITHIN=600            # 10 minutes in seconds

# ------------------------------------------------------------------------------
# 5.7 Solid Queue Concurrency & Performance Tuning
# ------------------------------------------------------------------------------
# SOLID_QUEUE_FIBERS=50
# SOLID_QUEUE_POLLING_INTERVAL=0.1
# SOLID_QUEUE_MAINTENANCE_THREADS=2
# MEDIA_QUEUE_THREADS=2
# SOLID_QUEUE_SHUTDOWN_TIMEOUT=30
# WAKA_DB_POOL=10
# MEDIA_DB_POOL=3
# API_DB_POOL=7
# DATA_SYNC_SCHEDULE="at 3:00am every Sunday"
# SOLID_QUEUE_IN_PUMA=0
# PIDFILE=tmp/pids/server.pid

# ------------------------------------------------------------------------------
# 5.8 Observability & App Store Listings
# ------------------------------------------------------------------------------
# DASHBOARD_BASE_URL=http://localhost:3000
# APP_VERSION=1.0.0
# GIT_SHA=main
# IOS_STORE_URL=https://apps.apple.com/app/idYOUR_APPLE_ID
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.rex9.rexone

# ------------------------------------------------------------------------------
# 5.9 Docker & Host Maintenance
# ------------------------------------------------------------------------------
# DOCKER_LOG_MAX_SIZE=10m
# DOCKER_LOG_MAX_FILE=3
# IMAGE_RETENTION_HOURS=168
# BUILD_CACHE_RETENTION_HOURS=168
